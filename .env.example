# === Required ===
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace_with_real_secret
OPENCODE_PATH=/root/.opencode/bin/opencode
OPENCODE_WORKING_DIR=/home/workspace

# === Recommended ===
OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free

# === Live status card ===
OPENCODE_STATUS_ENABLED=true
OPENCODE_STATUS_MODE=bubble
OPENCODE_STATUS_INTERVAL=1200
OPENCODE_STATUS_LINES=12
OPENCODE_STATUS_SHOW_THINKING=true
OPENCODE_STATUS_SHOW_REASONING=false
OPENCODE_STATUS_REASONING_MAX=320
OPENCODE_STATUS_SHOW_TOOL_OUTPUT=true
OPENCODE_STATUS_TOOL_OUTPUT_MAX=200

# === Interim assistant messages (model commentary during execution) ===
OPENCODE_INTERIM_TEXT=true
OPENCODE_INTERIM_TEXT_MIN=24
OPENCODE_COMPLETION_FOOTER=true

# === ACP permission requests: allow | reject ===
OPENCODE_PERMISSION_MODE=allow

# === Intent routing (only used for ambiguous messages) ===
OPENCODE_INTENT_ROUTING_ENABLED=true
OPENCODE_INTENT_ROUTING_TIMEOUT=12000
OPENCODE_INTENT_CONFIDENCE=0.75

# === Default notification mode: quiet | normal | debug ===
OPENCODE_NOTIFY_DEFAULT=normal

# === Optional: execution policy prepended to every prompt ('' = rely on AGENTS.md) ===
OPENCODE_EXECUTE_POLICY_PROMPT=

# === Security / session ===
REQUIRE_MENTION=true
SESSION_TIMEOUT=3600000
SESSION_MAX_HISTORY=20
ALLOWED_USERS=
LOG_LEVEL=info
