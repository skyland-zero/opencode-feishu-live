{
  "name": "opencode-feishu-live",
  "version": "0.1.0",
  "description": "Live Feishu/Lark bridge for OpenCode — streaming status cards: thinking, tool calls, and messages in real time",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:drive": "node dist/dev-drive.js",
    "watch": "tsc -w",
    "preflight": "bash scripts/preflight.sh",
    "deploy:service": "bash scripts/install-systemd-user.sh"
  },
  "keywords": [
    "opencode",
    "feishu",
    "lark",
    "bot",
    "bridge",
    "acp",
    "streaming"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.9.0",
    "@larksuiteoapi/node-sdk": "^1.58.0",
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "lru-cache": "^10.1.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
